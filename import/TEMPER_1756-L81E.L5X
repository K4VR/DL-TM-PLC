<Routine Name="ENDSCN" Type="RLL">
<Description>
<![CDATA[End Scan Control Block]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Description>
<![CDATA[GE Rung 4 — ) Call set time & date block when required. ) Copy the Status word into the write register, Move the first six bits from the At2Plc register directly over to the Plc2At register these are for the Fault Finder Screen Acks and they just get copied through.]]>
</Description>
<Text>
<![CDATA[XIC(M0231)JSR(SETTIME,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Description>
