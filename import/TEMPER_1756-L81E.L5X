<Description>
<![CDATA[GE Rung 18]]>
</Description>
<Text>
<![CDATA[[XIO(WKRLVL0),XIO(M0900)XIO(WKRLVL1)XIO(WKRLVL2)XIO(WKRLVL5)XIO(FFFB523)XIO(FFFB525),XIO(WKRLVL1)XIO(WKRLVL5)XIO(M0898)XIO(FFFB523)XIO(FFFB524)XIO(FFFB528),XIC(WKRLVLT),XIO(M0897),XIO(MILLTRN)XIC(M0914)]XIC(M0899)OTL(FFFB528);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Description>
<![CDATA[GE Rung 19]]>
</Description>
<Text>
<![CDATA[[XIC(FFACK5),XIC(M0910)]OTU(FFFB523);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Description>
<![CDATA[GE Rung 19]]>
</Description>
<Text>
<![CDATA[[XIC(FFACK5),XIC(M0910)]OTU(FFFB524);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Description>
<![CDATA[GE Rung 19]]>
</Description>
<Text>
<![CDATA[[XIC(FFACK5),XIC(M0910)]OTU(FFFB525);]]>
</Text>
