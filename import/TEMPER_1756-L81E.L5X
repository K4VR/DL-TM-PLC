</Rung>
<Rung Number="50" Type="N">
<Description>
<![CDATA[GE Rung 44 — Front Screw position is sent from the AT. Convert from percent to inches SDPOSTN = SDACTUL 6000/1000.]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)MOV(0,R00124);]]>
</Text>
</Rung>
<Rung Number="51" Type="N">
<Description>
<![CDATA[GE Rung 46 — Calculate the bottom stack difference. MAXEFRS = 31000 NWEFRSB = DIABUB/2 + DIAWKB STKDFSB = MAXEFRS - NWEFRSB]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)MUL(SDACTUL,6000,R00989D);]]>
</Text>
</Rung>
<Rung Number="52" Type="N">
<Description>
<![CDATA[GE Rung 46 — Calculate the bottom stack difference. MAXEFRS = 31000 NWEFRSB = DIABUB/2 + DIAWKB STKDFSB = MAXEFRS - NWEFRSB]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)DIV(R00989D,1000,SDPOSTN);]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Description>
<![CDATA[GE Rung 48]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)DIV(DIABUB,2,R00989D);]]>
</Text>
</Rung>
<Rung Number="54" Type="N">
<Description>
<![CDATA[GE Rung 48]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)ADD(R00989D,DIAWKB,NWEFRSB);]]>
</Text>
</Rung>
<Rung Number="55" Type="N">
<Description>
<![CDATA[GE Rung 48]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)OTE(CONT_RUNPERM_48);]]>
</Text>
</Rung>
<Rung Number="56" Type="N">
<Description>
<![CDATA[GE Rung 49 — Calculate the Radius of the Bottom Roll Stack Difference for positioning the Work Roll at maximum distance from the Passline.]]>
</Description>
<Text>
<![CDATA[XIC(CONT_RUNPERM_48)SUB(MAXEFRS,NWEFRSB,STCKDFB);]]>
</Text>
</Rung>
<Rung Number="57" Type="N">
<Description>
<![CDATA[GE Rung 51]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)DIV(DIABUB,2,R00989D);]]>
</Text>
</Rung>
