<![CDATA[XIO(WKRLVL1)XIO(WKRLVL2)XIO(WKRLVL3)XIO(WKRLVL4)XIO(WKRLVL5)OTE(WKRLVL0);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
