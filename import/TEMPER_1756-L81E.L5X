</Description>
<Text>
<![CDATA[XIO(FFSTAT1)EQU(FFFB1LO,0)EQU(FFUA1LO,0)OTE(FFSET1);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Description>
<![CDATA[GE Rung 18]]>
</Description>
<Text>
<![CDATA[XIO(FFSTAT1)AND(FFFB1LO,FF_F1LO,FF_F1LO);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Description>
<![CDATA[GE Rung 18]]>
</Description>
<Text>
<![CDATA[XIO(FFSTAT1)OR(FF_F1LO,FFUA1LO,FFUA1LO);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Description>
<![CDATA[GE Rung 18]]>
</Description>
<Text>
