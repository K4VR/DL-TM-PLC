<Programs>
<Program Name="PIOPLC" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Description>
<![CDATA[GE Logicmaster 90-30 program PIOPLC converted for ControlLogix 1756-L81E]]>
</Description>
<Tags/>
<Routines>
<Routine Name="SYSBITS" Type="RLL">
<Description>
<![CDATA[GE %S/%SA/%SC emulation]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate FST_SCN (%S0001)]]>
</Description>
<Text>
<![CDATA[XIO(FirstScanDone)OTE(FST_SCN);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Description>
<![CDATA[GE Rung 0 — latch first-scan complete]]>
</Description>
<Text>
<![CDATA[OTE(FirstScanDone);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate ALW_ON (%S0007)]]>
</Description>
<Text>
<![CDATA[OTE(ALW_ON);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate T_100MS (%S0004) timer]]>
</Description>
<Text>
<![CDATA[TON(CLK100_TMR,100,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate T_100MS (%S0004) pulse]]>
</Description>
<Text>
<![CDATA[XIC(CLK100_TMR.DN)OTE(T_100MS);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate T_100MS (%S0004) reset]]>
</Description>
<Text>
<![CDATA[XIC(CLK100_TMR.DN)RES(CLK100_TMR);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate T_SEC (%S0005) timer]]>
</Description>
<Text>
<![CDATA[TON(CLKSEC_TMR,1000,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate T_SEC (%S0005) pulse]]>
</Description>
<Text>
<![CDATA[XIC(CLKSEC_TMR.DN)OTE(T_SEC);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate T_SEC (%S0005) reset]]>
</Description>
<Text>
<![CDATA[XIC(CLKSEC_TMR.DN)RES(CLKSEC_TMR);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate T_MIN (%S0006) timer]]>
</Description>
<Text>
<![CDATA[TON(CLKMIN_TMR,60000,0);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate T_MIN (%S0006) pulse]]>
</Description>
<Text>
<![CDATA[XIC(CLKMIN_TMR.DN)OTE(T_MIN);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Description>
<![CDATA[GE Rung 0 — emulate T_MIN (%S0006) reset]]>
</Description>
<Text>
<![CDATA[XIC(CLKMIN_TMR.DN)RES(CLKMIN_TMR);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<Description>
<![CDATA[GE _MAIN block]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Description>
<![CDATA[GE Rung 0 — run system-bit emulation before _MAIN]]>
</Description>
<Text>
<![CDATA[JSR(SYSBITS,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Description>
<![CDATA[GE Rung 5]]>
</Description>
<Text>
<![CDATA[XIC(ALW_OFF)XIO(ALW_ON)OTE(M0003);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Description>
<![CDATA[GE Rung 6]]>
</Description>
<Text>
<![CDATA[XIC(M0003)XIC(M0004)OTE(M0004);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Description>
<![CDATA[GE Rung 7]]>
</Description>
<Text>
<![CDATA[XIC(M0003)XIC(M0005)OTE(M0005);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Description>
<![CDATA[GE Rung 9]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)JSR(TOP_OP,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Description>
<![CDATA[GE Rung 10]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)JSR(TDR_OP,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Description>
<![CDATA[GE Rung 11]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)JSR(BOP_OP,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Description>
<![CDATA[GE Rung 12]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)JSR(BDR_OP,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Description>
<![CDATA[GE Rung 13]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)OTE(M0012);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Description>
<![CDATA[GE Rung 14]]>
</Description>
<Text>
<![CDATA[XIC(ALW_ON)JSR(ACT_CWG,0);]]>
</Text>
